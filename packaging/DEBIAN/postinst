#!/bin/sh
set -e

PKG=sunfounder-tft35ips
VERSION=1.0.0
SRC=/usr/src/$PKG-$VERSION

case "$1" in
configure)
    # device-tree overlay (kernel independent)
    for d in /boot/firmware/overlays /boot/overlays; do
        if [ -d "$d" ] && [ -f "$SRC/$PKG.dtbo" ]; then
            install -m 644 "$SRC/$PKG.dtbo" "$d/$PKG.dtbo" || true
        fi
    done

    # enable the overlay once
    CFG=""
    for c in /boot/firmware/config.txt /boot/config.txt; do
        if [ -f "$c" ]; then CFG="$c"; break; fi
    done
    if [ -n "$CFG" ] && ! grep -q '^dtoverlay=sunfounder-tft35ips' "$CFG"; then
        cp "$CFG" "$CFG.bak-$(date +%Y%m%d%H%M%S)"
        printf 'dtoverlay=sunfounder-tft35ips\n' >> "$CFG"
    fi

    # build and install the module for the running kernel
    if command -v dkms >/dev/null 2>&1; then
        dkms add -m "$PKG" -v "$VERSION" >/dev/null 2>&1 || true
        if dkms build -m "$PKG" -v "$VERSION" >/dev/null 2>&1; then
            dkms install --force -m "$PKG" -v "$VERSION" >/dev/null 2>&1 || true
        else
            echo "sunfounder-tft35ips: DKMS build failed." >&2
            echo "sunfounder-tft35ips: install the headers for $(uname -r), then run: sudo dkms autoinstall" >&2
        fi
        depmod -a >/dev/null 2>&1 || true
    fi

    # some distros keep a copy of the module in the initramfs
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u -k all >/dev/null 2>&1 || true
    fi

    # ask for the calibration on the first desktop start after installing
    mkdir -p /var/lib/sunfounder-tft35ips
    if [ -f /etc/udev/rules.d/99-ads7846-calibration.rules ]; then
        rm -f /var/lib/sunfounder-tft35ips/calibrate-once
    else
        touch /var/lib/sunfounder-tft35ips/calibrate-once
    fi

    # X11-only desktops need the fbdev driver (modesetting flips without damage)
    if [ -d /etc/X11 ] && [ -d /usr/share/xsessions ] && \
       [ ! -d /usr/share/wayland-sessions ]; then
        FB=$(grep -l sunfounder /sys/class/graphics/fb*/name 2>/dev/null | head -1 |
             sed 's#/sys/class/graphics/\(fb[0-9]*\)/name#/dev/\1#')
        if [ -z "$FB" ]; then
            if grep -qs vc4 /sys/class/graphics/fb0/name; then FB=/dev/fb1; else FB=/dev/fb0; fi
        fi
        mkdir -p /etc/X11/xorg.conf.d
        printf 'Section "Device"\n    Identifier "SunFounder TFT panel"\n    Driver     "fbdev"\n    Option     "fbdev" "%s"\nEndSection\n' \
            "$FB" > /etc/X11/xorg.conf.d/20-sunfounder-tft-x11.conf
    fi
    ;;
esac

exit 0
