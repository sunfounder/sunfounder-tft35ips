#!/usr/bin/env python3
"""touch-calibrate — 4-point calibration for the 3.5" panel (labwc/Wayland).

One tap per target (4 taps total). The same-spot guard rejects a second tap on
the previous cross, so a stray double-tap cannot shift the next point.
After saving: DONE (the matrix is applied without a reboot).
"""
import sys, subprocess, threading, time
import colorsys
import re
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gtk, Gdk, GLib, Pango, PangoCairo
import evdev
from evdev import ecodes

DEVICE_NAME = "ADS7846 Touchscreen"
HELPER = ["sudo", "-n", "/usr/local/sbin/apply-touch-calibration"]
RULES_FILE = "/etc/udev/rules.d/99-ads7846-calibration.rules"
MARGIN = 0.12
TAPS = 1
NAMES = ["TOP-LEFT", "TOP-RIGHT", "BOTTOM-LEFT", "BOTTOM-RIGHT"]
DEBOUNCE = 0.25


def solve3(A, b):
    AtA = [[sum(A[k][i] * A[k][j] for k in range(len(A))) for j in range(3)] for i in range(3)]
    Atb = [sum(A[k][i] * b[k] for k in range(len(A))) for i in range(3)]
    M = [row[:] + [Atb[i]] for i, row in enumerate(AtA)]
    for i in range(3):
        p = max(range(i, 3), key=lambda r: abs(M[r][i]))
        if abs(M[p][i]) < 1e-9:
            raise ValueError("degenerate")
        M[i], M[p] = M[p], M[i]
        for r in range(3):
            if r != i:
                f = M[r][i] / M[i][i]
                for c in range(i, 4):
                    M[r][c] -= f * M[i][c]
    return [M[i][3] / M[i][i] for i in range(3)]


class Calibrator(Gtk.Window):
    def __init__(self, dev):
        super().__init__()
        self.dev = dev
        self.ax = dev.absinfo(ecodes.ABS_X)
        self.ay = dev.absinfo(ecodes.ABS_Y)
        self.set_decorated(False)
        self.fullscreen()

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.area = Gtk.DrawingArea()
        self.area.connect("draw", self.on_draw)

        overlay = Gtk.Overlay()
        overlay.add(self.area)
        self.box.pack_start(overlay, True, True, 0)

        self.btnbox = Gtk.Box(spacing=10)
        self.btnbox.set_border_width(6)
        self.btn_retry = Gtk.Button(label="RETRY")
        self.btn_exit = Gtk.Button(label="EXIT")
        self.btn_clear = Gtk.Button(label="Clear")
        self.btn_recal = Gtk.Button(label="Recalibrate")
        self.btn_done = Gtk.Button(label="Done")
        self.btn_retry.connect("clicked", lambda b: self.retry())
        self.btn_exit.connect("clicked", lambda b: Gtk.main_quit())
        self.btn_clear.connect("clicked", lambda b: self.clear_strokes())
        self.btn_recal.connect("clicked", lambda b: self.retry())
        self.btn_done.get_style_context().add_class("primary")
        self.btn_done.connect("clicked", lambda b: Gtk.main_quit())
        for b in (self.btn_retry, self.btn_exit, self.btn_clear, self.btn_recal, self.btn_done):
            self.btnbox.pack_start(b, True, True, 0)
        # the buttons float over the drawing area: the touch keeps working
        # underneath them, so a stroke can start or end anywhere on the panel
        self.btnbox.set_halign(Gtk.Align.FILL)
        self.btnbox.set_valign(Gtk.Align.END)
        overlay.add_overlay(self.btnbox)
        self.add(self.box)

        css = Gtk.CssProvider()
        css.load_from_data(b"""
window, .background { background-color: #0a0f1e; }
box { background-color: transparent; }
button { font-size: 14px; padding: 9px 10px; border-radius: 10px;
         background-image: none; background-color: #141c30; color: #cdd6e4;
         border: 1px solid #2b3550; box-shadow: none; text-shadow: none; }
button:hover { background-color: #1b2540; }
button:active { background-color: #223055; }
button.primary { background-color: #ffc53d; color: #1a1200;
                 border-color: #ffc53d; font-weight: 700; }
""")
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.reset()
        self.connect("key-press-event", self.on_key)
        self.show_all()
        self.btnbox.hide()
        threading.Thread(target=self.read_loop, daemon=True).start()
        GLib.timeout_add(1000, self.heartbeat)

    def start_test(self):
        m = load_matrix()
        if m is None:
            self.standalone = False
            return False
        self.M = m
        self.mode = "test"
        self.standalone = True
        self.strokes = []
        self.cur = None
        self.done = True
        self.show_buttons(ok=True)
        self.queue_draw()
        return True

    def reset(self):
        self.samples = [[] for _ in range(4)]
        self.points = []
        self.idx = 0
        self.tap_n = 0
        self.done = False
        self.mode = "calib"
        self.standalone = False
        self.strokes = []
        self.cur = None
        self.M = None
        self.last_ts = 0.0
        self.hb = 0
        self.message = "TAP THE YELLOW CROSS"
        self.sub = NAMES[0]
        if hasattr(self, "btnbox"):
            self.btnbox.hide()

    def clear_strokes(self):
        self.strokes = []
        self.cur = None
        self.queue_draw()

    def retry(self):
        self.reset()
        self.show_all()
        self.btnbox.hide()
        self.queue_draw()

    def heartbeat(self):
        self.hb += 1
        self.queue_draw()
        return True

    @staticmethod
    def targets(w, h):
        m = MARGIN
        return [(int(w * m), int(h * m)), (int(w * (1 - m)), int(h * m)),
                (int(w * m), int(h * (1 - m))), (int(w * (1 - m)), int(h * (1 - m)))]

    BG = (0.039, 0.059, 0.118)
    AMBER = (1.0, 0.773, 0.239)
    DONE_COL = (0.302, 0.851, 0.478)
    IDLE_COL = (0.353, 0.396, 0.475)
    MUTED = (0.541, 0.580, 0.651)

    def text(self, cr, s, size, y, color=(1, 1, 1), bold=False, w=None):
        layout = PangoCairo.create_layout(cr)
        layout.set_text(s, -1)
        desc = Pango.FontDescription("Noto Sans CJK SC, Noto Sans SC, Sans %d" % size)
        if bold:
            desc.set_weight(Pango.Weight.BOLD)
        layout.set_font_description(desc)
        tw, th = layout.get_pixel_size()
        if w is not None:
            cr.move_to((w - tw) / 2, y)
        else:
            cr.move_to(0, y)
        cr.set_source_rgb(*color)
        PangoCairo.show_layout(cr, layout)

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        cr.set_source_rgb(*self.BG)
        cr.paint()
        if self.mode == "test":
            return self.draw_test(w, h, cr)
        for i, (x, y) in enumerate(self.targets(w, h)):
            if i < self.idx:
                col = self.DONE_COL
            elif i == self.idx and not self.done:
                col = self.AMBER
            else:
                col = self.IDLE_COL
            cr.set_source_rgb(*col)
            cr.set_line_width(3 if i == self.idx else 2)
            r = 18 if i == self.idx else 14
            cr.arc(x, y, r, 0, 6.2832)
            cr.stroke()
            cr.move_to(x - 28, y); cr.line_to(x + 28, y); cr.stroke()
            cr.move_to(x, y - 28); cr.line_to(x, y + 28); cr.stroke()
        # progress: one bar per target
        bw, gap = 26, 8
        x0 = (w - (4 * bw + 3 * gap)) / 2
        for i in range(4):
            done = (i <= self.idx) and not self.done
            cr.set_source_rgb(*(self.AMBER if done else (0.169, 0.208, 0.314)))
            cr.rectangle(x0 + i * (bw + gap), 30, bw, 4)
            cr.fill()

        if TAPS > 1:
            tx, ty = self.targets(w, h)[min(self.idx, 3)]
            self.text(cr, "%d/%d" % (self.tap_n + 1, TAPS), 11, ty + 34, self.MUTED, w=w)
        self.text(cr, self.message, 20, h / 2 - 10, (1, 1, 1), bold=True, w=w)
        self.text(cr, self.sub, 12, h - 26, self.MUTED, w=w)
        return False

    def draw_test(self, w, h, cr):
        cr.set_line_width(4)
        cr.set_line_cap(1)  # round
        cr.set_line_join(1)
        n = 0
        for s in self.strokes:
            for i in range(1, len(s)):
                hue = (n * 0.012) % 1.0
                r, g, b = colorsys.hsv_to_rgb(hue, 0.85, 1.0)
                cr.set_source_rgb(r, g, b)
                cr.move_to(s[i - 1][0], s[i - 1][1])
                cr.line_to(s[i][0], s[i][1])
                cr.stroke()
                n += 1
        title = "CALIBRATION TEST" if getattr(self, "standalone", False) else "CALIBRATION DONE"
        self.text(cr, title, 17, 12, (1, 1, 1), bold=True, w=w)
        self.text(cr, "DRAW TO TEST THE TOUCH", 11, 36, self.MUTED, w=w)
        return False
    def read_loop(self):
        # Applying the calibration rebinds the SPI device, so the event node
        # disappears for a moment; reopen it and keep reading.
        while True:
            x = y = None
            pending = down = False
            try:
                for ev in self.dev.read_loop():
                    if ev.type == ecodes.EV_SYN:
                        # during a drag only SYN_REPORT arrives: record the
                        # point so the test canvas follows the finger
                        if self.mode == "test" and down and x is not None and y is not None:
                            GLib.idle_add(self.add_point, x, y)
                    elif ev.type == ecodes.EV_ABS:
                        if ev.code == ecodes.ABS_X:
                            x = ev.value
                        elif ev.code == ecodes.ABS_Y:
                            y = ev.value
                        if pending and x is not None and y is not None:
                            pending = False
                            GLib.idle_add(self.add_point, x, y)
                    elif ev.type == ecodes.EV_KEY and ev.code == ecodes.BTN_TOUCH:
                        down = ev.value == 1
                        if ev.value == 0:
                            pending = False
                            x = y = None
                            GLib.idle_add(self.end_stroke)
                        elif x is not None and y is not None:
                            GLib.idle_add(self.add_point, x, y)
                        else:
                            pending = True
            except OSError:
                time.sleep(0.5)
                dev = find_device()
                if dev is not None:
                    self.dev = dev
                    self.cur = None
    def end_stroke(self):
        self.cur = None
        return False

    def add_test_point(self, rx, ry):
        if not self.M:
            return
        u = (rx - self.ax.min) / max(1, self.ax.max - self.ax.min)
        v = (ry - self.ay.min) / max(1, self.ay.max - self.ay.min)
        a, b, c, d, e, f = self.M
        w = self.area.get_allocated_width()
        h = self.area.get_allocated_height()
        x = (a * u + b * v + c) * w
        y = (d * u + e * v + f) * h
        if self.cur is None:
            self.cur = [(x, y)]
            self.strokes.append(self.cur)
        else:
            self.cur.append((x, y))
        self.queue_draw()

    def add_point(self, rx, ry):
        if self.mode == "test":
            self.add_test_point(rx, ry)
            return False
        now = time.time()
        if self.done or self.idx >= 4:
            return False
        if now - self.last_ts < DEBOUNCE:
            return False
        self.last_ts = now
        u = (rx - self.ax.min) / max(1, self.ax.max - self.ax.min)
        v = (ry - self.ay.min) / max(1, self.ay.max - self.ay.min)
        # "didn't move to the next cross" guard (only between points)
        if self.tap_n == 0 and self.points:
            pu, pv, _, _ = self.points[-1]
            if abs(u - pu) < 0.05 and abs(v - pv) < 0.05:
                self.message = "SAME SPOT - TAP THE YELLOW CROSS"
                self.sub = "move to " + NAMES[self.idx]
                self.queue_draw()
                return False
        self.samples[self.idx].append((u, v))
        self.tap_n += 1
        print("POINT %d tap %d raw=%d,%d norm=%.4f,%.4f" % (self.idx, self.tap_n, rx, ry, u, v),
              file=sys.stderr, flush=True)
        if self.tap_n < TAPS:
            self.message = "TAP AGAIN (%d/%d)" % (self.tap_n + 1, TAPS)
        else:
            su = sum(s[0] for s in self.samples[self.idx]) / TAPS
            sv = sum(s[1] for s in self.samples[self.idx]) / TAPS
            w = self.area.get_allocated_width()
            h = self.area.get_allocated_height()
            tx, ty = self.targets(w, h)[self.idx]
            self.points.append((su, sv, (tx + 0.5) / w, (ty + 0.5) / h))
            print("POINT %d avg=%.4f,%.4f target=%d,%d" % (self.idx, su, sv, tx, ty),
                  file=sys.stderr, flush=True)
            self.idx += 1
            self.tap_n = 0
            if self.idx < 4:
                self.message = "OK - TAP THE NEXT CROSS"
                self.sub = "next: " + NAMES[self.idx]
            else:
                self.finish()
        self.queue_draw()
        return False

    def finish(self):
        A, bs, bt = [], [], []
        for u, v, s, t in self.points:
            A.append((u, v, 1.0)); bs.append(s); bt.append(t)
        try:
            a, b, c = solve3(A, bs)
            d, e, f = solve3(A, bt)
        except Exception as ex:
            self.fail("FAILED: %s" % ex)
            return
        if max(abs(a), abs(b), abs(d), abs(e)) > 4 or abs(c) > 2 or abs(f) > 2:
            self.fail("FAILED - tap again")
            return
        res = 0.0
        for (u, v, s, t) in self.points:
            res = max(res, abs(a * u + b * v + c - s), abs(d * u + e * v + f - t))
        if res > 0.12:
            self.fail("TOO INACCURATE (%.2f)" % res)
            return
        self.matrix = "%.6f %.6f %.6f %.6f %.6f %.6f 0 0 1" % (a, b, c, d, e, f)
        print("MATRIX " + self.matrix, file=sys.stderr, flush=True)
        r = subprocess.run(HELPER + [self.matrix], capture_output=True, text=True)
        if r.returncode == 0:
            self.M = (a, b, c, d, e, f)
            self.mode = "test"
            self.standalone = False
            self.strokes = []
            self.cur = None
            self.message = "CALIBRATION SAVED"
            self.sub = "calibration applied - draw on the screen to test it"
            self.done = True
            self.show_buttons(ok=True)
        else:
            self.fail("SAVE FAILED")
        self.queue_draw()

    def show_buttons(self, ok):
        self.btnbox.show_all()
        for b in (self.btn_retry, self.btn_exit):
            b.set_visible(not ok)
        for b in (self.btn_clear, self.btn_recal, self.btn_done):
            b.set_visible(ok)

    def fail(self, msg):
        print("FAIL " + msg, file=sys.stderr, flush=True)
        self.message = msg
        self.sub = "retry or exit"
        self.done = True
        self.show_buttons(ok=False)
        self.queue_draw()

    def retry(self):
        self.reset()
        self.queue_draw()
        return False

    def on_key(self, w, ev):
        if ev.keyval == 65307:
            Gtk.main_quit()


def load_matrix():
    """Return the calibration matrix saved in the udev rule, or None."""
    try:
        with open(RULES_FILE, encoding="utf-8") as f:
            text = f.read()
        m = re.search(r'LIBINPUT_CALIBRATION_MATRIX="([^"]+)"', text)
        if m:
            v = [float(x) for x in m.group(1).split()]
            if len(v) >= 6:
                return tuple(v[:6])
    except Exception:
        pass
    return None


def find_device():
    for p in evdev.list_devices():
        d = evdev.InputDevice(p)
        if d.name == DEVICE_NAME:
            return d
    return None


def main():
    start_in_test = "--test" in sys.argv
    if "--reset" in sys.argv:
        r = subprocess.run(HELPER + ["--reset"], capture_output=True, text=True)
        print(r.stdout or r.stderr)
        return
    dev = find_device()
    if dev is None:
        print("touch device not found: " + DEVICE_NAME, file=sys.stderr)
        sys.exit(1)
    win = Calibrator(dev)
    if start_in_test:
        GLib.idle_add(win.start_test)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
