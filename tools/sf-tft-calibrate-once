#!/bin/sh
# Offer the touch calibration on every desktop login until a matrix is saved.
#
# Runs from /etc/xdg/autostart after the desktop is up, which is the first
# moment the driver and the touch device exist (the overlay is applied at boot).
RULES=/etc/udev/rules.d/99-ads7846-calibration.rules

[ -f "$RULES" ] && exit 0

# only when the panel driver is actually there
[ -e /sys/class/drm/card*-SPI-1 ] || exit 0

exec /usr/local/bin/touch-calibrate
